<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Salma App</title>

  <!-- Browser Tab Icon (Favicon) -->
  <link rel="icon" type="image/png" href="icon.png?v=2">
  
  <!-- iPhone Home Screen Icon & App Settings -->
  <link rel="apple-touch-icon" href="icon.png?v=2">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Salma App">
  
  <!-- Fonts: Dancing Script (Header), Quicksand (UI), Tajawal (Arabic fallback) -->
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Quicksand:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    /* DEFAULT: DARK MODE (Charcoal & Muted Plum) */
    :root {
      --bg-color: #121212; 
      --surface: #1C1C1E; 
      --primary: #9D6587; /* Muted Plum / Amethyst */
      --primary-hover: #865271;
      --primary-soft: rgba(157, 101, 135, 0.15); 
      --text-main: #FFFFFF; 
      --text-muted: #8E8E93; 
      --border-color: #2C2C2E; 
      --delete-bg: #FF3B30; 
      --surface-glass: rgba(28, 28, 30, 0.8); 
    }

    /* OVERRIDE: LIGHT MODE */
    :root.light-theme {
      --bg-color: #FCF4F6;
      --surface: #FFFFFF;
      --primary: #9D6587;
      --primary-hover: #865271;
      --primary-soft: #F4EAF0;
      --text-main: #594A4E;
      --text-muted: #B3A5A9;
      --border-color: #F7E6E9;
      --delete-bg: #FF6B6B;
      --surface-glass: rgba(255, 255, 255, 0.9);
    }

    * { box-sizing: border-box; }

    body {
      background: var(--bg-color);
      color: var(--text-main);
      font-family: 'Quicksand', 'Tajawal', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      margin: 0;
      overflow: hidden; 
      -webkit-tap-highlight-color: transparent;
      transition: background 0.4s ease, color 0.4s ease;
    }

    /* Custom Message Box */
    .message-box {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%) translateY(-150%);
      background: var(--surface);
      border: 1px solid var(--primary);
      color: var(--text-main);
      padding: 15px 25px;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      z-index: 10000;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: flex;
      align-items: center;
      gap: 15px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .message-box.show { transform: translateX(-50%) translateY(0); }
    .message-box button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-weight: bold;
      font-size: 0.85rem;
    }

    .menu-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 999;
    }
    .menu-overlay.active { opacity: 1; visibility: visible; }

    .side-menu {
      position: fixed;
      top: 0; left: -300px;
      width: 280px; height: 100vh;
      background: var(--surface);
      z-index: 1000;
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
      display: flex;
      flex-direction: column;
      padding: 40px 20px 20px;
      box-shadow: 10px 0 30px rgba(0,0,0,0.2);
      border-top-right-radius: 30px;
      border-bottom-right-radius: 30px;
    }
    .side-menu.active { transform: translateX(300px); }

    .side-menu-header {
      font-family: 'Dancing Script', cursive;
      font-size: 2.4rem; /* Reduced from 2.8rem */
      color: var(--primary);
      text-align: center;
      margin-bottom: 40px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 16px 20px;
      font-size: 1rem; /* Reduced from 1.1rem */
      font-weight: 600;
      color: var(--text-main);
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      background: transparent;
      width: 100%;
      text-align: left;
    }
    .menu-item:hover { background: var(--primary-soft); color: var(--primary); }
    .menu-item i { font-size: 1.1rem; width: 25px; text-align: center; }
    
    .spacer { flex-grow: 1; }
    
    .version-info { 
      text-align: center; 
      color: var(--text-muted); 
      font-size: 0.9rem; /* Reduced from 1.1rem */
      font-weight: 700; 
      letter-spacing: 2px; 
      margin-bottom: 20px;
    }

    .menu-bottom-bar {
      display: flex;
      justify-content: space-evenly;
      align-items: center;
      padding-top: 15px;
      border-top: 1px solid var(--border-color);
    }
    .menu-bottom-bar .icon-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.3rem;
      cursor: pointer;
      transition: color 0.3s, transform 0.2s;
      padding: 10px;
      border-radius: 50%;
    }
    .menu-bottom-bar .icon-btn:hover {
      color: var(--primary);
      background: var(--primary-soft);
      transform: scale(1.05);
    }

    .app-container {
      background: var(--surface);
      border-radius: 40px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
      width: 100%;
      max-width: 420px;
      height: 90vh; 
      max-height: 850px;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .header-section {
      padding: 30px 25px 15px;
      background: var(--surface-glass);
      backdrop-filter: blur(10px);
      z-index: 10;
      border-bottom: 1px solid var(--border-color);
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      margin-bottom: 25px;
    }

    .hamburger-btn {
      position: absolute;
      left: 0;
      background: var(--primary-soft);
      border: none;
      border-radius: 50%;
      width: 40px; height: 40px;
      display: flex; justify-content: center; align-items: center;
      font-size: 1.1rem;
      color: var(--primary);
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
    }
    .hamburger-btn:active { transform: scale(0.9); }

    h1 {
      font-family: 'Dancing Script', cursive;
      color: var(--primary);
      font-size: 2.2rem; /* Reduced from 2.6rem */
      margin: 0;
      font-weight: 700;
    }

    .tabs {
      display: flex;
      background: var(--bg-color);
      border-radius: 25px;
      padding: 6px;
      position: relative;
    }

    .tab-btn {
      flex: 1;
      background: transparent;
      border: none;
      padding: 10px 0;
      font-size: 0.9rem; /* Reduced from 1rem */
      font-weight: 700;
      font-family: inherit;
      color: var(--text-muted);
      cursor: pointer;
      border-radius: 20px;
      transition: color 0.3s ease;
      z-index: 1;
    }
    .tab-btn.active { color: white; }

    .tab-slider {
      position: absolute;
      top: 6px; bottom: 6px;
      width: calc(50% - 6px);
      background: var(--primary);
      border-radius: 20px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 12px rgba(157, 101, 135, 0.3);
    }

    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 25px 5px;
    }

    .section-title { font-weight: 700; color: var(--text-main); font-size: 1.1rem; }

    select {
      border: none; background: transparent; color: var(--text-muted);
      font-family: 'Quicksand', 'Tajawal', sans-serif; font-size: 0.85rem;
      font-weight: 600; outline: none; cursor: pointer; text-align: right;
    }
    select option { background: var(--surface); color: var(--text-main); }

    .list-container {
      list-style: none;
      padding: 10px 25px 25px;
      margin: 0;
      flex-grow: 1;
      overflow-y: auto;
    }
    .list-container::-webkit-scrollbar { display: none; }
    .list-container { -ms-overflow-style: none; scrollbar-width: none; }

    /* Swipe-to-delete Wrapper */
    .list-item-wrapper {
      position: relative;
      margin-bottom: 12px;
      border-radius: 24px;
      background: var(--delete-bg); 
      overflow: hidden;
      animation: slideUp 0.4s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    .delete-bg {
      position: absolute;
      top: 0; right: 0; bottom: 0; left: 0;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding-right: 25px;
      color: white;
      font-size: 1.3rem;
      z-index: 1;
    }

    .list-item {
      display: flex;
      align-items: center;
      background: var(--surface);
      padding: 16px 20px;
      border-radius: 24px;
      border: 1px solid var(--border-color);
      position: relative;
      z-index: 2;
      transition: transform 0.3s ease-out, background 0.3s, border-color 0.3s;
    }

    @keyframes slideUp { to { opacity: 1; transform: translateY(0); } }

    .list-item.completed {
      background: var(--bg-color); border-color: transparent;
    }

    .checkbox-wrapper {
      position: relative; width: 24px; height: 24px; margin-right: 15px;
      flex-shrink: 0; cursor: pointer;
    }
    .checkbox-wrapper input { opacity: 0; width: 0; height: 0; position: absolute; }

    .custom-checkbox {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      border: 2px solid var(--primary); border-radius: 50%;
      background: transparent; transition: all 0.2s ease;
      display: flex; justify-content: center; align-items: center;
    }
    .custom-checkbox::after {
      content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
      color: white; font-size: 11px; opacity: 0; transform: scale(0.5);
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .checkbox-wrapper input:checked ~ .custom-checkbox {
      background: var(--primary); border-color: var(--primary);
    }
    .checkbox-wrapper input:checked ~ .custom-checkbox::after { opacity: 1; transform: scale(1); }

    .item-text {
      flex: 1; font-size: 1.0rem; /* Reduced from 1.15rem */ font-weight: 600; word-break: break-word;
      transition: color 0.3s; color: var(--text-main);
    }
    .list-item.completed .item-text { text-decoration: line-through; color: var(--text-muted); }

    .actions { display: flex; gap: 8px; flex-shrink: 0; }
    
    .actions button {
      background: var(--bg-color); border-radius: 50%; width: 30px; height: 30px;
      display: flex; justify-content: center; align-items: center; border: none;
      color: var(--text-muted); font-size: 0.85rem; cursor: pointer; transition: all 0.2s;
    }
    .actions button:hover { background: var(--primary-soft); color: var(--primary); transform: scale(1.1); }
    
    /* Input Area */
    .input-wrapper {
      padding: 15px 25px; background: var(--surface);
      border-top: 1px solid var(--border-color); z-index: 10;
    }

    .input-group {
      display: flex; gap: 10px; background: var(--bg-color); padding: 6px;
      border-radius: 30px; border: 1px solid transparent; transition: all 0.3s;
      align-items: center;
    }
    .input-group:focus-within { border-color: var(--primary-soft); }

    input[type="text"] {
      flex: 1; padding: 10px 15px; border: none; background: transparent;
      font-size: 0.95rem; /* Reduced from 1.05rem */ font-weight: 600; font-family: inherit;
      color: var(--text-main); outline: none;
    }
    input[type="text"]::placeholder { color: var(--text-muted); font-weight: 500; }

    /* Edit Cancellation Button */
    .btn-cancel {
      background: transparent; border: none; color: var(--text-muted);
      font-size: 1.1rem; cursor: pointer; padding: 0 5px;
      display: none; transition: color 0.2s;
    }
    .btn-cancel:hover { color: var(--delete-bg); }

    button.btn-main {
      background: var(--primary); color: white; border: none; border-radius: 24px;
      padding: 0 20px; height: 38px; font-size: 0.95rem; /* Reduced */ font-weight: 700; cursor: pointer;
      font-family: inherit; transition: all 0.2s; white-space: nowrap;
    }
    button.btn-main:hover { background: var(--primary-hover); transform: scale(1.02); }
    button.btn-main:active { transform: scale(0.95); }
    button.btn-main:disabled { background: var(--text-muted); cursor: not-allowed; opacity: 0.7; }

    .empty-state {
      text-align: center; color: var(--text-muted); font-size: 1.0rem;
      font-weight: 600; padding: 50px 0; display: flex; flex-direction: column;
      align-items: center; gap: 15px;
    }
    .empty-state i { 
      font-size: 2.5rem; color: var(--primary-soft); background: var(--bg-color);
      width: 70px; height: 70px; display: flex; justify-content: center; align-items: center;
      border-radius: 50%;
    }

  </style>
</head>
<body>
  <div id="messageBox" class="message-box">
    <span id="messageText">Error goes here</span>
    <button id="messageClose">OK</button>
  </div>

  <div class="menu-overlay" id="menuOverlay"></div>
  
  <div class="side-menu" id="sideMenu">
    <div class="side-menu-header">Salma App</div>
    
    <!-- Future text links/categories can go here -->
    
    <div class="spacer"></div>
    <div class="version-info">v2.5</div>
    
    <div class="menu-bottom-bar">
      <button class="icon-btn" id="themeBtn" title="Toggle Theme">
        <i class="fas fa-sun"></i>
      </button>
      <button class="icon-btn" id="refreshBtn" title="Refresh App">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </div>

  <div class="app-container">
    <div class="header-section">
      <div class="header-top">
        <button class="hamburger-btn" id="openMenuBtn"><i class="fas fa-bars"></i></button>
        <h1>Salma App</h1>
      </div>

      <div class="tabs">
        <div class="tab-slider" id="tabSlider"></div>
        <button class="tab-btn active" data-tab="todo">To-Do</button>
        <button class="tab-btn" data-tab="wishlist">Wishlist</button>
      </div>
    </div>

    <div class="controls">
      <div class="section-title" id="sectionTitle">My Tasks</div>
      <select id="sortSelect">
        <option value="date-desc">Newest First</option>
        <option value="date-asc">Oldest First</option>
        <option value="name-asc">Name (A-Z)</option>
        <option value="name-desc">Name (Z-A)</option>
      </select>
    </div>

    <ul class="list-container" id="listContainer">
      <!-- Items dynamically injected -->
    </ul>

    <div class="input-wrapper">
      <div class="input-group">
        <input type="text" id="itemInput" placeholder="Add a new task...">
        <button class="btn-cancel" id="cancelEditBtn" title="Cancel Edit"><i class="fas fa-times"></i></button>
        <button class="btn-main" id="addButton">Add</button>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getFirestore, collection, addDoc, onSnapshot, deleteDoc, doc, updateDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCyES_YyIz54wHVYgHLFg_9gYbhfDz-PyU",
      authDomain: "salma-notes.firebaseapp.com",
      projectId: "salma-notes",
      storageBucket: "salma-notes.firebasestorage.app",
      messagingSenderId: "725168545178",
      appId: "1:725168545178:web:33a80db028670236b52e23"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // DOM Elements
    const itemInput = document.getElementById("itemInput");
    const addButton = document.getElementById("addButton");
    const cancelEditBtn = document.getElementById("cancelEditBtn");
    const sortSelect = document.getElementById("sortSelect");
    const listContainer = document.getElementById("listContainer");
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabSlider = document.getElementById('tabSlider');
    
    const openMenuBtn = document.getElementById('openMenuBtn');
    const menuOverlay = document.getElementById('menuOverlay');
    const sideMenu = document.getElementById('sideMenu');
    const refreshBtn = document.getElementById('refreshBtn');
    const themeBtn = document.getElementById('themeBtn');

    // Message Box
    const messageBox = document.getElementById('messageBox');
    const messageText = document.getElementById('messageText');
    const messageClose = document.getElementById('messageClose');
    
    function showMessage(text) {
      messageText.textContent = text;
      messageBox.classList.add('show');
    }
    messageClose.addEventListener('click', () => messageBox.classList.remove('show'));

    // Theme Logic
    const savedTheme = localStorage.getItem('salma_theme') || 'dark';
    if (savedTheme === 'light') document.documentElement.classList.add('light-theme');
    
    function updateThemeBtn() {
      const isLight = document.documentElement.classList.contains('light-theme');
      themeBtn.innerHTML = isLight ? '<i class="fas fa-moon"></i>' : '<i class="fas fa-sun"></i>';
    }
    updateThemeBtn();

    themeBtn.addEventListener('click', () => {
      document.documentElement.classList.toggle('light-theme');
      const isLight = document.documentElement.classList.contains('light-theme');
      localStorage.setItem('salma_theme', isLight ? 'light' : 'dark');
      updateThemeBtn();
    });

    // Menu Toggle
    const toggleMenu = () => {
      sideMenu.classList.toggle('active');
      menuOverlay.classList.toggle('active');
    };
    openMenuBtn.addEventListener('click', toggleMenu);
    menuOverlay.addEventListener('click', toggleMenu);

    refreshBtn.addEventListener('click', () => {
      refreshBtn.querySelector('i').classList.add('fa-spin');
      setTimeout(() => location.reload(), 500);
    });

    // App State
    let currentTab = 'todo';
    let todoItems = [];
    let wishlistItems = [];
    let editingId = null;

    const todoRef = collection(db, "tasks");
    const wishlistRef = collection(db, "wishlist");

    // DB Listeners
    onSnapshot(todoRef, (snapshot) => {
      todoItems = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      if (currentTab === 'todo') renderItems();
    });

    onSnapshot(wishlistRef, (snapshot) => {
      wishlistItems = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      if (currentTab === 'wishlist') renderItems();
    });

    // Reset editing state helper
    const resetInput = () => {
      editingId = null;
      itemInput.value = "";
      addButton.textContent = "Add";
      cancelEditBtn.style.display = "none";
    };

    // Tab Switching
    tabBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        tabSlider.style.transform = index === 0 ? 'translateX(0)' : 'translateX(100%)';
        currentTab = btn.dataset.tab;
        
        document.getElementById('sectionTitle').textContent = currentTab === 'todo' ? "My Tasks" : "My Wishes";
        itemInput.placeholder = currentTab === 'todo' ? "Add a new task..." : "What do you wish for?";
        
        resetInput();
        renderItems();
      });
    });

    // Cancel Edit Handler
    cancelEditBtn.addEventListener("click", resetInput);

    // Add/Update Handler
    addButton.addEventListener("click", async () => {
      const text = itemInput.value.trim();
      if (!text) return;
      
      const targetCollection = currentTab === 'todo' ? todoRef : wishlistRef;
      const targetCollectionName = currentTab === 'todo' ? "tasks" : "wishlist";

      try {
        addButton.textContent = "Saving...";
        addButton.disabled = true;

        if (editingId) {
          await updateDoc(doc(db, targetCollectionName, editingId), { text: text });
          resetInput();
        } else {
          await addDoc(targetCollection, {
            text: text,
            completed: false,
            createdAt: serverTimestamp()
          });
          itemInput.value = "";
        }
      } catch (error) {
        console.error("Firebase Error: ", error);
        showMessage("Firebase Error: Check your database security rules.");
      } finally {
        if (!editingId) addButton.textContent = "Add";
        addButton.disabled = false;
      }
    });

    itemInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") addButton.click();
    });

    sortSelect.addEventListener("change", renderItems);

    function renderItems() {
      listContainer.innerHTML = "";
      
      let itemsToRender = currentTab === 'todo' ? [...todoItems] : [...wishlistItems];
      const targetCollectionName = currentTab === 'todo' ? "tasks" : "wishlist";
      
      if (itemsToRender.length === 0) {
        const emptyMsg = currentTab === 'todo' ? "You're all caught up!" : "Your wishlist is empty.";
        const emptyIcon = currentTab === 'todo' ? "fa-check-circle" : "fa-star";
        listContainer.innerHTML = `
          <div class="empty-state">
            <i class="fas ${emptyIcon}"></i>
            <span>${emptyMsg}</span>
          </div>`;
        return;
      }

      const sortVal = sortSelect.value;
      if (sortVal === "date-desc") {
        itemsToRender.sort((a, b) => (b.createdAt?.seconds || Date.now()) - (a.createdAt?.seconds || Date.now()));
      } else if (sortVal === "date-asc") {
        itemsToRender.sort((a, b) => (a.createdAt?.seconds || Date.now()) - (b.createdAt?.seconds || Date.now()));
      } else if (sortVal === "name-asc") {
        itemsToRender.sort((a, b) => (a.text || "").localeCompare(b.text || ""));
      } else if (sortVal === "name-desc") {
        itemsToRender.sort((a, b) => (b.text || "").localeCompare(a.text || ""));
      }
      
      itemsToRender.forEach((item, index) => {
        const liContainer = document.createElement("li");
        liContainer.className = "list-item-wrapper";
        liContainer.style.animationDelay = `${index * 0.05}s`;

        const deleteBg = document.createElement("div");
        deleteBg.className = "delete-bg";
        deleteBg.innerHTML = '<i class="fas fa-trash"></i>';

        const li = document.createElement("div");
        li.className = `list-item ${item.completed ? 'completed' : ''}`;
        
        const cbWrapper = document.createElement("label");
        cbWrapper.className = "checkbox-wrapper";

        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.checked = item.completed;
        cb.addEventListener("change", async () => {
          await updateDoc(doc(db, targetCollectionName, item.id), { completed: cb.checked });
        });
        
        const customCb = document.createElement("div");
        customCb.className = "custom-checkbox";
        
        cbWrapper.appendChild(cb);
        cbWrapper.appendChild(customCb);

        const span = document.createElement("span");
        span.className = "item-text";
        span.textContent = item.text;
        
        const actions = document.createElement("div");
        actions.className = "actions";
        
        const editBtn = document.createElement("button");
        editBtn.innerHTML = '<i class="fas fa-pen"></i>';
        editBtn.addEventListener("click", () => {
          itemInput.value = item.text;
          editingId = item.id;
          addButton.textContent = "Update";
          cancelEditBtn.style.display = "block";
          itemInput.focus();
        });
        actions.appendChild(editBtn);
        
        li.appendChild(cbWrapper);
        li.appendChild(span);
        li.appendChild(actions);

        liContainer.appendChild(deleteBg);
        liContainer.appendChild(li);
        listContainer.appendChild(liContainer);

        // Mobile Swipe-to-delete logic
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        li.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
          li.style.transition = 'none'; 
        }, {passive: true});

        li.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          const x = e.touches[0].clientX;
          currentX = x - startX;
          if (currentX < 0) { 
             const move = Math.max(currentX, -120); 
             li.style.transform = `translateX(${move}px)`;
          }
        }, {passive: true});

        const handleSwipeEnd = async () => {
          if (!isDragging) return;
          isDragging = false;
          li.style.transition = 'transform 0.3s ease-out';
          
          if (currentX < -60) {
            li.style.transform = `translateX(-100%)`;
            setTimeout(async () => {
              liContainer.style.display = 'none';
              await deleteDoc(doc(db, targetCollectionName, item.id));
              // Clear editing mode if we delete the item we are currently editing
              if (editingId === item.id) resetInput();
            }, 300);
          } else {
            li.style.transform = `translateX(0)`;
          }
          currentX = 0;
        };

        li.addEventListener('touchend', handleSwipeEnd);
        li.addEventListener('touchcancel', handleSwipeEnd);
      });
    }
  </script>
</body>
</html>
